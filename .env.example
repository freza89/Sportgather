# Salin ke .env lalu sesuaikan. Jangan commit .env.
# Infrastruktur lokal (lihat infra/docker-compose.yml)

# Koneksi admin/pemilik tabel — HANYA untuk migrasi & tes.
DATABASE_ADMIN_URL=postgres://sportgather:sportgather@localhost:55432/sportgather
# Koneksi aplikasi memakai role sg_app (tanpa BYPASSRLS) agar RLS berlaku.
# API menolak start bila role ini superuser atau bisa melewati RLS.
DATABASE_URL=postgres://sg_app:sg_app_dev@localhost:55432/sportgather
# Password login sg_app yang dipasang saat `pnpm db:migrate` (lokal saja; produksi diatur ops).
DB_APP_PASSWORD=sg_app_dev

REDIS_URL=redis://localhost:56379
# Job terjadwal (pengingat RSVP H-1). Nyalakan di satu instance API saja.
JOBS_ENABLED=false
S3_ENDPOINT=http://localhost:59000
S3_ACCESS_KEY=sportgather
S3_SECRET_KEY=sportgather-dev-secret
S3_BUCKET=sportgather-documents
SMTP_URL=smtp://localhost:51025

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Rahasia HMAC untuk OTP & token (≥32 karakter). Wajib diganti di produksi.
AUTH_SECRET=dev-only-secret-change-me-dev-only-secret
SESSION_DAYS=30

# Web (server-side): alamat API untuk rewrite /api/* dan Server Components
API_URL=http://localhost:4000

# Integrasi: mock | real (real butuh kredensial di secret manager, bukan di repo)
PAYMENT_PROVIDER=mock
WHATSAPP_PROVIDER=mock
SMS_PROVIDER=mock
BANK_VERIFICATION_PROVIDER=mock

# Midtrans (M4). Sandbox: isi server key dari dashboard sandbox (Settings → Access Keys),
# lalu set PAYMENT_PROVIDER=real. Uji kredensial: pnpm --filter api midtrans:check
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
# Iris (penarikan dana) belum aktif → tetap mock walau Snap memakai sandbox.
PAYOUT_PROVIDER=mock
# Fee platform per pembayaran online & kebijakan penarikan (rupiah).
PLATFORM_FEE=2500
QRIS_SERVICE_FEE_ENABLED=false
WITHDRAWAL_MIN=50000
WITHDRAWAL_FEE=2500
SETTLEMENT_DELAY_HOURS=0
