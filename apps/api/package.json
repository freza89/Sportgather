{
  "name": "@sportgather/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json -w --preserveWatchOutput & node --env-file-if-exists=../../.env --watch dist/main.js)",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "midtrans:check": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env scripts/midtrans-sandbox-check.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1177.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/static": "^10.1.12",
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-fastify": "^12.6.0",
    "@nestjs/swagger": "^12.1.2",
    "@sportgather/db": "workspace:*",
    "@sportgather/shared": "workspace:*",
    "bullmq": "^6.7.8",
    "drizzle-orm": "^0.45.4",
    "fastify": "5.12.8",
    "ioredis": "^5.11.1",
    "pdf-lib": "^1.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.6.0",
    "@sportgather/config": "workspace:*",
    "@swc/core": "^1.16.22",
    "@types/node": "^26.6.6",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
